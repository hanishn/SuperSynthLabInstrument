  "dialog": {
    "about": {
      "title": "Super Synth Lab - Instrument",
      "features_1": "पियानो कीबोर्ड, आइसोमॉर्फ़िक ग्रिड, पैड, गिटार फ़्रेटबोर्ड और अधिक से बजाएँ",
      "features_2": "17+ सिंथेसिस इंजन: Subtractive, FM, Physical Modelling, Granular, Additive और अधिक",
      "features_3": "ADSR एनवेलप और फ़िल्टर से ध्वनि को आकार दें",
      "features_4": "21+ प्रभाव लगाएँ: Reverb, Delay, Chorus, Distortion और अधिक",
      "features_5": "MIDI कीबोर्ड और कंट्रोलर कनेक्ट करें",
      "privacy_header": "गोपनीयता",
      "privacy_text": "Super Synth Lab - Instrument पूरी तरह आपके ब्राउज़र में चलता है। कोई डेटा एकत्र नहीं होता, कोई ऑडियो रिकॉर्ड या प्रेषित नहीं होता, कोई खाता आवश्यक नहीं। सभी सेटिंग्स आपके डिवाइस पर स्थानीय रूप से संग्रहीत हैं।",
      "feedback_header": "प्रतिक्रिया",
      "feedback_text": "प्रश्न, बग रिपोर्ट, या सुविधा अनुरोध? प्रतिक्रिया भेजें:",
      "legal_header": "कानूनी",
      "legal_text": "निर्माता: Nathan Hanish, 2026। सर्वाधिकार सुरक्षित। यह सॉफ़्टवेयर व्यक्तिगत और शैक्षिक उपयोग के लिए यथा-रूप प्रदान किया गया है।",
      "description": "Super Synth Lab - Instrument एक ब्राउज़र-आधारित मल्टी-इंजन सिंथेसाइज़र है जिसमें 30+ कंट्रोल सरव़ेस, 17+ सिंथेसिस इंजन और 28+ प्रभाव हैं। मोबाइल पर टच-ऑप्टिमाइज़्ड, डेस्कटॉप पर कीबोर्ड और MIDI समर्थित।",
      "features_header": "Super Synth Lab - Instrument क्या कर सकता है?"
    },
    "reset": {
      "title": "सभी सेटिंग्स रीसेट करें?",
