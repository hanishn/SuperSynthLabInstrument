  "dialog": {
    "about": {
      "title": "Super Synth Lab - Instrument",
      "features_1": "Hrajte na klaviaturu, izomorfni mrizky, pady, kytarovy hmatnik a dalsi",
      "features_2": "Vybirejte z 17+ synteznich motoru: subtraktivni, FM, fyzikalni modelovani, granularni, aditivni a dalsi",
      "features_3": "Tvarujte svuj zvuk pomoci ADSR obalek a filtru",
      "features_4": "Aplikujte 21+ efektu: reverb, delay, chorus, zkreseni a dalsi",
      "features_5": "Pripojte MIDI klaviatury a kontrolery",
      "privacy_header": "Soukromi",
      "privacy_text": "Super Synth Lab - Instrument bezi zcela ve vasem prohlizeci. Zadna data se nesbireji, zadny zvuk se nenahrava ani neprenasei, zadne ucty nejsou potreba. Vsechna nastaveni se ukladaji lokalne na vasem zarizeni.",
      "feedback_header": "Zpetna vazba",
      "feedback_text": "Otazky, hlaseni chyb nebo pozadavky na funkce? Poslete zpetnou vazbu na:",
