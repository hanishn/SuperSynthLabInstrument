{
  "version": "1.0.0",
  "typography": {
    "fontFamily": "system-ui, -apple-system, sans-serif",
    "scale": {
      "xs": "10px",
      "sm": "11px",
      "body": "13px",
      "md": "14px",
      "lg": "16px",
      "xl": "18px",
      "h3": "20px",
      "h2": "24px",
      "h1": "28px"
    },
    "weight": {
      "normal": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },
  "colors": {
    "bg": {
      "surface": "#0e1117",
      "elevated": "#161b22",
      "overlay": "#1c2128",
      "input": "#21262d"
    },
    "text": {
      "primary": "rgba(220, 235, 245, 0.95)",
      "secondary": "rgba(220, 235, 245, 0.70)",
      "muted": "rgba(220, 235, 245, 0.50)",
      "disabled": "rgba(220, 235, 245, 0.35)"
    },
    "accent": {
      "cyan": "#00d4ff",
      "purple": "#a855f7",
      "rose": "#f43f5e",
      "amber": "#f59e0b",
      "green": "#22c55e",
      "orange": "#f97316"
    },
    "noteColors": {
      "C": "#ff3344",
      "Cs": "#ff6622",
      "D": "#ff9900",
      "Ds": "#ddbb00",
      "E": "#aadd00",
      "F": "#44cc44",
      "Fs": "#00bbaa",
      "G": "#0099dd",
      "Gs": "#3366ff",
      "A": "#6644ff",
      "As": "#9933dd",
      "B": "#cc33aa"
    },
    "surfaceThemes": {
      "warm": { "accent": "#d4a040", "bg": "#1a1610" },
      "cool": { "accent": "#4488cc", "bg": "#101418" },
      "neutral": { "accent": "#888888", "bg": "#141414" }
    }
  },
  "spacing": {
    "xxs": "2px",
    "xs": "4px",
    "sm": "6px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "xxl": "24px"
  },
  "touchTargets": {
    "minimum": "44px",
    "comfortable": "48px",
    "large": "56px",
    "phoneMinimum": "36px"
  },
  "borderRadius": {
    "sm": "3px",
    "md": "6px",
    "lg": "8px",
    "round": "50%"
  },
  "opacity": {
    "active": 1.0,
    "hover": 0.85,
    "inactive": 0.60,
    "disabled": 0.40,
    "overlay": 0.20,
    "subtle": 0.12
  },
  "layout": {
    "topbarHeight": "36px",
    "topbarHeightPhone": "32px",
    "headerPadding": "6px 8px",
    "buttonGap": "4px",
    "sectionGap": "8px",
    "safeAreaBottom": "env(safe-area-inset-bottom, 0px)"
  },
  "controls": {
    "sliderTrackHeight": "6px",
    "sliderThumbSize": "18px",
    "dropdownHeight": "28px",
    "dropdownHeightPhone": "24px"
  },
  "humanFactors": {
    "fingerSpacingMinMm": 25,
    "fingerSpacingMaxMm": 35,
    "fingerSpacingPx": 50,
    "iosLandscapeUsableHeight": "375px",
    "iosPortraitUsableHeight": "710px"
  }
}
